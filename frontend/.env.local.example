# Backend REST base URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Backend WebSocket URL for live fraud alerts
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/alerts

# Optional same-site proxy (first-party refresh cookie). Set both on the frontend host:
#   NEXT_PUBLIC_API_URL=/api/v1
#   API_PROXY_TARGET=https://your-api.onrender.com
# and set REFRESH_COOKIE_SAMESITE=lax on the backend. See next.config.ts for the trade-off.
